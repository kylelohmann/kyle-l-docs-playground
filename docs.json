{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Arccos Benchmarks API",
  "description": "Compare a golfer's Arccos stats with tour-level players and every handicap in between.",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "concepts"]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/compare-to-tour",
              "guides/strokes-gained",
              "guides/webhooks",
              "guides/authentication",
              "guides/errors"
            ]
          },
          {
            "group": "Build on the demo app",
            "pages": ["build/architecture", "build/extend", "build/production"]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Endpoints",
            "openapi": "openapi.yaml"
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": ["curl", "javascript", "python"]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  }
}
